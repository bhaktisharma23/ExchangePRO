# Frontend environment (Vite exposes only variables prefixed with VITE_ to browser code).
# Copy to frontend/.env.local to override.

# Backend URL used by the Vite dev-server proxy (not shipped to the browser).
VITE_DEV_BACKEND_URL=http://localhost:8080

# Optional absolute API base URL for production builds. Leave empty to use same-origin /api.
VITE_API_BASE_URL=
