# =====================================================================
# EXCHANGE PRO - environment variables
# Copy to .env (which is git-ignored) and fill in the secrets:
#     cp .env.example .env
# Read by: docker compose (automatically) and the Spring Boot backend
# (spring.config.import of ../.env). Real environment variables
# always take precedence over this file.
# =====================================================================

# ---- PostgreSQL container (docker-compose.yml) ----
POSTGRES_DB=exchangepro
POSTGRES_USER=exchangepro
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# ---- Backend datasource ----
DB_URL=jdbc:postgresql://localhost:5432/exchangepro
DB_USERNAME=exchangepro
DB_PASSWORD=change-me-local-only
DB_POOL_MAX_SIZE=10

# ---- Backend server ----
SERVER_PORT=8080
# Comma-separated list of browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# never | when-authorized | always  (use "never" outside local development)
HEALTH_SHOW_DETAILS=always
LOG_LEVEL_APP=INFO

# ---- Market data ----
# SIMULATION (synthetic prices, always labelled SIMULATED DATA) is the only available mode.
# REAL is reserved for a licensed provider; the backend refuses to start with it today.
MARKET_DATA_MODE=SIMULATION
